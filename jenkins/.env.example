# Copy to .env (git-ignored) and fill in. Never commit the real .env.
JENKINS_PORT=8085
JENKINS_URL=http://localhost:8085/
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me

# HTTPS URL of your GitHub repository
GITHUB_REPO_URL=https://github.com/<user>/<repo>.git

# Docker Hub username + access token (Account settings -> Personal access tokens, Read & Write)
DOCKERHUB_USER=
DOCKERHUB_TOKEN=

# Build notifications: Gmail address + 16-character App Password (Google Account -> Security -> App passwords)
NOTIFY_EMAIL=
SMTP_USER=
SMTP_PASSWORD=
